# Keep the build context small and, more importantly, keep secrets and local
# state out of the image.

# The Neon connection string lives here. On a host it comes from the platform's
# environment variables instead, and it must never be baked into an image.
.env
*.env

# The old SQLite database and photo files. Superseded by Postgres, and this is
# real personal data that has no business in a container image.
data/

.venv/
__pycache__/
*.pyc
.pytest_cache/

# One-off migration script; it is for a developer's machine, not the server.
migrate_sqlite_to_postgres.py
prune_photos.py

.DS_Store
